# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.claude/

# testing
/coverage

# next.js
/.next/
/.next-prelaunch/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# committed templates (placeholders only)
!.env.example
!supabase/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# takumi/rebuild-spec tooling byproducts
docs/.rebuild-state.json
docs/.spec-promote-pending.json
docs/**/confidence-report_*.md
docs/features/.stale
plans/**/artifacts/
