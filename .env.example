# Copy to .env.local. Values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Event start, server-only (ISO-8601 with offset). Missing/invalid = launched, prelaunch gate off.
# Real event date (already past). Use a future date locally to exercise the prelaunch gate.
EVENT_START_AT=2025-12-26T18:30:00+07:00
