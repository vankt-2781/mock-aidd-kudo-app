# Copy to .env.local. Values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Event start (ISO-8601 with offset). Real event: 2025-12-26T18:30:00+07:00 (already past; countdown shows 00s).
NEXT_PUBLIC_EVENT_START_AT=2025-12-26T18:30:00+07:00
